{
  "version": 1,
  "repository": "/absolute/path/to/your/project",
  "trustLocalCode": true,
  "surface": "cli",
  "entry": "app.py",
  "interpreter": "/usr/bin/python3",
  "devChecks": [
    { "id": "syntax", "executable": "/usr/bin/python3", "args": ["-m", "py_compile", "app.py"] }
  ],
  "checks": [
    {
      "id": "uppercase_note",
      "outcome": "Loading a note by relative path prints its exact uppercased contents and exits successfully",
      "scenarios": [
        {
          "id": "load_sample",
          "name": "Open a sample note",
          "args": ["note.txt"],
          "fixtures": [{ "path": "note.txt", "content": "Hello, world!\n" }],
          "expect": [
            { "channel": "stdout", "op": "equals", "value": "HELLO, WORLD!\n" },
            { "channel": "exit", "op": "equals", "value": 0 }
          ]
        }
      ]
    }
  ]
}
