{
  "version": 1,
  "repository": "/absolute/path/to/your/project",
  "trustLocalCode": true,
  "surface": "tui",
  "entry": "app.py",
  "interpreter": "/usr/bin/python3",
  "checks": [
    {
      "id": "open_note",
      "outcome": "Typing a note name and pressing Enter shows the note contents on screen",
      "scenarios": [
        {
          "id": "type_filename",
          "name": "Open a note from the terminal UI",
          "args": [],
          "fixtures": [{ "path": "welcome.txt", "content": "A note from the fixture." }],
          "steps": [
            { "type": "wait", "ms": 200 },
            { "type": "type", "text": "welcome.txt" },
            { "type": "press", "key": "enter" },
            { "type": "wait", "ms": 200 },
            { "type": "observe" }
          ],
          "expect": [{ "channel": "screen", "op": "contains", "value": "A note from the fixture." }]
        }
      ]
    }
  ]
}
