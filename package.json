{
  "name": "pi-worq",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Plan and execute Pi SDK agents with probing-question subagents and independent review, managed from the main Pi session",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "bin": {
    "worq": "./bin/worq.mjs",
    "worq-check-swarm": "./bin/worq-check-swarm.mjs"
  },
  "files": [
    "index.ts",
    "bin/",
    "src/",
    "workflows/"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "typebox": "1.3.27"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "zod": "^4.0.0"
  }
}
