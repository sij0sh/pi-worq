{
  "name": "pi-worq",
  "version": "0.0.5",
  "type": "module",
  "description": "Focused coding runs with independent CLI and terminal UI verification in Pi",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19" },
  "pi": { "extensions": ["./index.ts"] },
  "bin": { "worq": "./bin/worq.mjs" },
  "files": ["index.ts", "bin/", "src/", "examples/", "prompts/"],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "typebox": "1.3.27"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  }
}
